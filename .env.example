# ==============================================================================
# Dulce Cosmetics - Environment Variables Template
# Monorepo: app/web/, backend/, database/, docs/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos Neon (PostgreSQL Serverless)
# ------------------------------------------------------------------------------
# Cadena de conexión directa o con pooling de Neon DB (Punto 8)
NEON_DATABASE_URL="postgresql://neondb_owner:npg_sample_pass@ep-dulce-cosmetics-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:npg_sample_pass@ep-dulce-cosmetics-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth.js (Autenticación Admin & Sub-Admin)
# ------------------------------------------------------------------------------
# Secreto para firmar tokens JWT (Generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-nextauth-key-min-32-chars-dulce-cosmetics"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Despliegue en Vercel
# ------------------------------------------------------------------------------
# URL pública del despliegue en Vercel o dominio personalizado
VERCEL_URL="dulce-cosmetics.vercel.app"
NEXT_PUBLIC_APP_URL="https://dulcecosmetics.com"

# ------------------------------------------------------------------------------
# 4. Servidor de Correo (Nodemailer / SMTP / Resend)
# ------------------------------------------------------------------------------
# Notificaciones por email al administrador cuando se registra un pedido (Puntos 8, 18)
EMAIL_SERVER="smtp://apikey:your-smtp-api-key@smtp.resend.com:587"
EMAIL_FROM="Dulce Cosmetics <pedidos@dulcecosmetics.com>"
ADMIN_EMAIL="admin@dulcecosmetics.com"
RESEND_API_KEY="re_sample_resend_api_key_12345"

# ------------------------------------------------------------------------------
# 5. Configuración Comercial Neiva (WhatsApp & Contacto)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="573177780413"
NEXT_PUBLIC_STORE_NAME="Dulce Cosmetics"
NEXT_PUBLIC_STORE_LOCATION="Neiva, Huila, Colombia"
